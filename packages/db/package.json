{
  "name": "@eventflow/db",
  "version": "1.0.0",
  "type": "module",

  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  
  "scripts": {
    "build": "tsc -b",
    "generate": "dotenv -e ../../.env -- prisma generate --config=../../prisma.config.ts",
    "dev": "dotenv -e ../../.env -- prisma generate --watch --config=../../prisma.config.ts",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev --config=../../prisma.config.ts",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "typescript": "5.4.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0"
  }
}